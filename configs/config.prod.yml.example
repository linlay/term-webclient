# Optional production-style structured overrides loaded via CONFIG_PATH.
# Environment variables still have the highest priority.

terminal:
  recent-sessions-file: data/recent-sessions.json
  recent-sessions-per-tool: 10
  files:
    enabled: false
  ssh:
    credentials-file: data/ssh-credentials.json

assist:
  enabled: true
  # Keep /compatible-mode/v1 in base-url so requests resolve to /chat/completions.
  base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
  api-key: ${ASSIST_API_KEY:}
  model: qwen-plus
  timeout-seconds: 30
  max-screen-text-chars: 500
  debug-log: false
