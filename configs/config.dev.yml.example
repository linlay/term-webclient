# Optional development overrides loaded via CONFIG_PATH.
# Only include structured values that should differ from embedded defaults.

terminal:
  files:
    enabled: true
  cli-clients:
    - id: codex
      label: Codex
      command: codex
      args: []
      workdir: .
      env: {}
      shell: /bin/zsh
    - id: claude
      label: Claude Code
      command: claude
      args: []
      workdir: .
      env: {}
      shell: /bin/zsh

assist:
  enabled: true
  # Keep /compatible-mode/v1 in base-url so requests resolve to /chat/completions.
  base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
  api-key: ${ASSIST_API_KEY:}
  model: qwen-plus
  timeout-seconds: 30
  max-screen-text-chars: 500
  debug-log: false
