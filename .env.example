# Runtime env contract for repo root or packaged release root.
# Copy to `.env`, then edit values for your machine or deployment target.

# Network
BACKEND_HOST=127.0.0.1
BACKEND_PORT=11946
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=11947

# Optional external YAML overrides.
# Local backend run from `backend/`: CONFIG_PATH=../configs/config.dev.yml
# Docker / packaged release:        CONFIG_PATH=./configs/config.prod.yml
# CONFIG_PATH=

# Web auth
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Generate bcrypt hash:
# htpasswd -nbBC 10 '' 'change-this-password' | cut -d: -f2
# Required when AUTH_ENABLED=true.
AUTH_PASSWORD_HASH_BCRYPT=
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# App JWT auth
APP_AUTH_ENABLED=true
# Fill APP_AUTH_LOCAL_PUBLIC_KEY or APP_AUTH_JWKS_URI.
# For .env, prefer a single-line base64-encoded RSA public key.
# Multi-line PEM is also supported via real environment injection or CONFIG_PATH YAML.
APP_AUTH_LOCAL_PUBLIC_KEY=
# Optional fallback when APP_AUTH_LOCAL_PUBLIC_KEY is empty.
APP_AUTH_JWKS_URI=
APP_AUTH_ISSUER=your-app-issuer
APP_AUTH_JWKS_CACHE_SECONDS=300
APP_AUTH_AUDIENCE=appterm
APP_AUTH_CLOCK_SKEW_SECONDS=30

# Assist / LLM
# Example-enabled: fill ASSIST_API_KEY before starting the backend.
ASSIST_ENABLED=true
# Keep /v1 in the base URL so the backend resolves /v1/chat/completions.
ASSIST_BASE_URL=https://api.babelark.com/v1
ASSIST_API_KEY=
ASSIST_MODEL=Qwen3.5-397B-A17B
ASSIST_TIMEOUT_SECONDS=30
ASSIST_MAX_SCREEN_TEXT_CHARS=500
ASSIST_DEBUG_LOG=false
ASSIST_SYSTEM_PROMPT=

# Terminal files
TERMINAL_FILES_ENABLED=true

# SSH
TERMINAL_SSH_CREDENTIALS_FILE=data/ssh-credentials.json
TERMINAL_SSH_MASTER_KEY=replace_with_a_random_secret

# Frontend-only build/runtime variables
VITE_API_BASE=
VITE_COPILOT_REFRESH_MS=2000
