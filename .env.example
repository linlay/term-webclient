# Runtime env contract for repo root or packaged release root.
# Copy to `.env`, then edit values for your machine or deployment target.

# Network
BACKEND_HOST=127.0.0.1
BACKEND_PORT=11937
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=11947

# Optional external YAML overrides.
# Create your own YAML under `configs/` only when `.env` is not enough.
# Local backend run from `backend/`: CONFIG_PATH=../configs/config.dev.yml
# Docker / packaged release:        CONFIG_PATH=./configs/config.prod.yml
# CONFIG_PATH=

# Web auth
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Generate bcrypt hash:
# htpasswd -nbBC 10 '' 'change-this-password' | cut -d: -f2
# Required when AUTH_ENABLED=true.
AUTH_PASSWORD_HASH_BCRYPT='$2y$10$Lpy241UWfq8U4oMW9cPNSOs5lkd6wZRyWF3wNnPm0Jkg9.LEvdbx6'
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# App JWT auth
APP_AUTH_ENABLED=true
# Copy `configs/local-public-key.example.pem` to `configs/local-public-key.pem` first.
# Relative paths are resolved from the `.env` directory.
APP_AUTH_LOCAL_PUBLIC_KEY_FILE=./configs/local-public-key.pem
# Optional fallback when APP_AUTH_LOCAL_PUBLIC_KEY_FILE is empty.
APP_AUTH_JWKS_URI=
APP_AUTH_ISSUER=your-app-issuer
APP_AUTH_JWKS_CACHE_SECONDS=300
APP_AUTH_AUDIENCE=appterm
APP_AUTH_CLOCK_SKEW_SECONDS=30

# Assist / LLM
# Example-enabled: fill ASSIST_API_KEY before starting the backend.
ASSIST_ENABLED=true
# Recommended for Aliyun Bailian Beijing region. Replace with the matching DashScope region if needed.
ASSIST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASSIST_API_KEY=
ASSIST_MODEL=qwen-plus
ASSIST_TIMEOUT_SECONDS=30
ASSIST_MAX_SCREEN_TEXT_CHARS=500
ASSIST_DEBUG_LOG=false
ASSIST_SYSTEM_PROMPT=You are an assistant for a terminal web client. Based on the most recent terminal or console output, provide the best next-step shell commands. Return strict JSON with a top-level object containing a suggestions array of exactly 5 items. Each suggestion must include command, reason, and weight. weight must be an integer from 0 to 100, and suggestions must be ordered from highest weight to lowest weight. Prefer concise, actionable commands that directly verify, fix, or advance what the recent console output indicates. Commands must be plain shell commands only, without markdown fences, numbering, or explanation text in the command field.

# Terminal files
TERMINAL_FILES_ENABLED=true

# SSH
TERMINAL_SSH_CREDENTIALS_FILE=data/ssh-credentials.json
TERMINAL_SSH_MASTER_KEY=replace_with_a_random_secret

# Frontend-only build/runtime variables
VITE_API_BASE=
VITE_COPILOT_REFRESH_MS=2000
